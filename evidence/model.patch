+	runAllTypesNoOutput(t, func() {
+		ResetStatTraffic(7000)
+		const concurrentAdds = 50
+		var wg sync.WaitGroup
+		for i := 0; i < concurrentAdds; i++ {
+			wg.Add(1)
+			go func() {
+				defer wg.Done()
+				_, _ = AddStatTraffic(10, 7000)
+			}()
+		}
+		wg.Wait()
+		test.IsEqual(t, GetStatTraffic(), uint64(concurrentAdds*10))
