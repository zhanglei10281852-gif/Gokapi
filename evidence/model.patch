+			go func() {
+				defer wgStale.Done()
+				_, _ = AddStatTraffic(10, 6999)
+			}()
+		}
+		wgStale.Wait()
+		test.IsEqual(t, GetStatTraffic(), uint64(concurrentAdds*10))
